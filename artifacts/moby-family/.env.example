# Backend API origin (do not add a trailing slash). Restart Vite after changes.
VITE_API_BASE_URL=https://yelisei-project.onrender.com

# Use UUIDs that actually exist in the backend database.
VITE_FAMILY_ID=11111111-1111-4111-8111-111111111111
VITE_PARENT_USER_ID=11111111-1111-4111-8111-111111111101
VITE_CHILD_USER_ID=11111111-1111-4111-8111-111111111121

# Required by some parent-side money/task operations; leave blank until you have the real card UUID.
VITE_PARENT_CARD_ID=
